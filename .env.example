# Copy to .env and generate DIFFERENT random values for every secret/password.
# Database passwords must be URL-safe (e.g. hex) for the composed DATABASE_URL.
POSTGRES_ADMIN_PASSWORD=
AFTERSALES_DB_PASSWORD=
CHATWOOT_DB_PASSWORD=
REDIS_PASSWORD=
CHATWOOT_SECRET_KEY_BASE=
SESSION_SECRET=
APP_MODE=demo
DATABASE_URL=postgresql+psycopg://aftersales:CHANGE_ME@localhost:5432/aftersales
CHATWOOT_INSTANCE_ID=local-chatwoot
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_PUBLIC_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=0
CHATWOOT_INBOX_ID=0
CHATWOOT_BOT_ID=
CHATWOOT_BOT_ACCESS_TOKEN=
# Optional dedicated support token for methods unavailable to the bot; never administrator token.
CHATWOOT_READ_ACCESS_TOKEN=
CHATWOOT_BOT_WEBHOOK_SECRET=
CHATWOOT_ACCOUNT_WEBHOOK_SECRET=
CHATWOOT_WIDGET_TOKEN=
CHATWOOT_WIDGET_IDENTITY_SECRET=
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000
AGENT_ENABLED=true
FIXED_REPLY_DELAY_SECONDS=0
WEBHOOK_TOLERANCE_SECONDS=300
# Initially true only to create the first local Chatwoot administrator. Disable afterwards.
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=true
# Only for the isolated local demo after verifying v4.19.0 SafeFetch behavior; hosted default false.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false
# Bootstrap-only administrator token: pass in the invoking shell; never put it in runtime config.
# CHATWOOT_ADMIN_ACCESS_TOKEN=
# Bootstrap callback root; SafeFetch may reject private networks. Use a verified HTTPS tunnel then.
CHATWOOT_CALLBACK_BASE_URL=http://agent-api.internal:8000
# Seed only: supply in shell or docker compose run -e; never injected into normal services.
# M0_DEMO_PASSWORD=
# M0 intentionally has no LLM configuration, orders, inventory, refunds or fulfillment.
